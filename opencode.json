{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": [
    "opencode-browser",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": true
    }
  },
  "permission": {
    "lsp": "allow"
  }
}
